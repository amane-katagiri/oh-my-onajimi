#!/usr/bin/env node
import preset from "../packages/textlint-rule-preset-onajimi/index.js";
import count from "../packages/textlint-rule-preset-onajimi/rules/count.js";
import regexp from "../packages/textlint-rule-preset-onajimi/rules/regexp.js";
import presetRulesLib from "../packages/textlint-rule-preset-onajimi/rules/preset-rules.js";
import { main } from "../packages/onajimi/src/main.js";
import { setPresetLib } from "../packages/onajimi/src/preset.js";

setPresetLib({ count, regexp, presetRules: presetRulesLib.presetRules });

process.exitCode = await main({ argv: process.argv.slice(2), preset });
