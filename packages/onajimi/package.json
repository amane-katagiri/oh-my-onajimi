{
  "name": "onajimi",
  "version": "0.1.0",
  "private": true,
  "description": "筆者のプロファイルを作り、それに沿って下書きを textlint で検査する CLI",
  "license": "MIT",
  "author": "Amane Katagiri",
  "type": "module",
  "bin": {
    "onajimi": "bin/onajimi.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@textlint/kernel": "15.8.0",
    "@textlint/markdown-to-ast": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "@textlint/textlint-plugin-text": "15.8.0",
    "kuromojin": "3.0.1",
    "sentence-splitter": "5.0.1",
    "textlint-rule-max-ten": "5.0.0",
    "textlint-rule-preset-onajimi": "0.1.0",
    "textlint-rule-prh": "6.1.1",
    "textlint-rule-sentence-length": "5.2.1",
    "textlint-util-to-string": "3.3.4",
    "yaml": "2.9.1"
  }
}
